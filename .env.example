# ── Secret Backend ──────────────────────────────────────────────────────────
# How to source API keys. Options:
#   file   (default) — read *_FILE vars from filesystem (Docker secrets, K8s, tmpfs)
#   keytar — read from OS keychain (macOS Keychain / GNOME Keyring / Windows Credential Manager)
#   env    — plain env vars only (opt-out; fine for development)
IMAGE_MCP_SECRET_BACKEND=file

# ── Image Provider ───────────────────────────────────────────────────────────
# Required. Which image backend to use: openai | azure | together | custom
IMAGE_PROVIDER=openai

# ── API Key ──────────────────────────────────────────────────────────────────
# Option A: plain env var (dev only — avoid in production)
IMAGE_API_KEY=sk-...
# Option B: path to a file containing the key (Docker secret, K8s secret, tmpfs)
# IMAGE_API_KEY_FILE=/run/secrets/image_api_key
# Option C: OS keychain — set IMAGE_MCP_SECRET_BACKEND=keytar and run:
#   bun run secret:store IMAGE_API_KEY

# ── Base URL / Endpoint ───────────────────────────────────────────────────────
# Required for IMAGE_PROVIDER=azure  → your Azure resource endpoint
# Required for IMAGE_PROVIDER=custom → your OpenAI-compatible endpoint URL
# Optional  for IMAGE_PROVIDER=openai → defaults to https://api.openai.com/v1
# Not used  for IMAGE_PROVIDER=together (hardcoded to api.together.xyz)
# IMAGE_BASE_URL=https://my-resource.openai.azure.com

# ── Azure-specific ────────────────────────────────────────────────────────────
# Required when IMAGE_PROVIDER=azure
# IMAGE_DEPLOYMENT=my-gpt-image-deployment
# IMAGE_API_VERSION=2025-04-01-preview

# ── Custom provider model list ────────────────────────────────────────────────
# Comma-separated list of model names exposed when IMAGE_PROVIDER=custom
# IMAGE_MODELS=llama3,mistral

# ── MCP Server ──────────────────────────────────────────────────────────────
# Transport: "http" (default, multi-client) or "stdio" (local subprocess)
IMAGE_MCP_TRANSPORT=http

# HTTP bind address and port (only relevant when IMAGE_MCP_TRANSPORT=http)
IMAGE_HTTP_HOST=127.0.0.1
IMAGE_PORT=3000

# MCP Fastify DNS-rebinding / browser-origin protection (hostnames, no ports)
# Add your public hostname when binding to 0.0.0.0 behind a reverse proxy.
IMAGE_HTTP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
IMAGE_HTTP_ALLOWED_ORIGINS=localhost,127.0.0.1,[::1]

# Bearer token to protect the /mcp endpoint (required by default)
# Set IMAGE_REQUIRE_MCP_AUTH=false to disable (local dev only)
# Option A: plain
# IMAGE_MCP_API_KEY=your-secret-mcp-key
# Option B: file
# IMAGE_MCP_API_KEY_FILE=/run/secrets/mcp_api_key

# ── Image Generation Defaults ────────────────────────────────────────────────
IMAGE_DEFAULT_MODEL=gpt-image-2

# ── MCP Features ────────────────────────────────────────────────────────────
IMAGE_USE_ELICITATION=true
IMAGE_USE_SAMPLING=true

# ── Security ────────────────────────────────────────────────────────────────
IMAGE_MAX_REQUESTS_PER_MINUTE=60
IMAGE_REQUIRE_MCP_AUTH=true

# ── Logging ─────────────────────────────────────────────────────────────────
IMAGE_LOG_LEVEL=info
